<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="32dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:fitsSystemWindows="true">

    <!-- Dark Mode Toggle -->
    <LinearLayout
        android:id="@+id/layoutDarkMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgDarkMode"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_dark_mode"
            app:tint="#333333" />

        <TextView
            android:id="@+id/tvDarkMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark mode off"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Profile Image -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/ic_profile_user"
        android:scaleType="centerCrop"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_profile_circle"
        android:clipToOutline="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Username -->
    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        android:letterSpacing="0.03"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintTop_toTopOf="@id/imgProfile"/>

    <!-- Stats Card -->
    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        app:layout_constraintTop_toBottomOf="@id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Posts -->
        <TextView
            android:id="@+id/rowPosts"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Posts"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:background="@drawable/bg_stat_item"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Following -->
        <TextView
            android:id="@+id/rowFollowing"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Following"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:background="@drawable/bg_stat_item"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Followers -->
        <TextView
            android:id="@+id/rowFollowers"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Followers"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:background="@drawable/bg_stat_item"
            android:clickable="true"
            android:focusable="true"/>

        <!-- My Club -->
        <TextView
            android:id="@+id/rowMyClub"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="My Club"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:background="@drawable/bg_stat_item"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- More Section -->
    <LinearLayout
        android:id="@+id/moreSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/statsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Settings"
            android:gravity="center_vertical"
            android:paddingStart="12dp"/>

        <TextView
            android:id="@+id/rowUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Check for updates"
            android:gravity="center_vertical"
            android:paddingStart="12dp"/>

        <TextView
            android:id="@+id/rowAbout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="About"
            android:gravity="center_vertical"
            android:paddingStart="12dp"/>
    </LinearLayout>

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Log out"
        android:textAllCaps="false"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
